  "vars": {
    "SUPABASE_URL": "https://ysddeszckbpmfhyrikxe.supabase.co",
    "R2_PUBLIC_BASE_URL": "https://pub-5620ca196c674ca09cc311878651751d.r2.dev",
    "NEXT_PUBLIC_SENTRY_STOREFRONT_DSN": "https://2bd272fb46ed2a85f4ac7a0c0e283623@o4511931505246208.ingest.de.sentry.io/4511936339181648"
  },
  "secrets": {
    "required": [
      "SUPABASE_SERVICE_ROLE_KEY",
      "RESEND_API_KEY",
      "RESEND_FROM_EMAIL",
      "ORDER_RECEIPT_EMAIL",
