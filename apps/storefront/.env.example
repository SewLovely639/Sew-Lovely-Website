NEXT_PUBLIC_APP_URL=http://localhost:3000
# Must match the admin app while using the local development CMS adapter.
SEW_LOVELY_CONTENT_FILE=C:\absolute\path\to\Sew-Lovely 2\packages\cms\data\content.json
SEW_LOVELY_CUSTOMERS_FILE=C:\absolute\path\to\Sew-Lovely 2\packages\cms\data\customers.json
SEW_LOVELY_ORDERS_FILE=C:\absolute\path\to\Sew-Lovely 2\packages\cms\data\orders.json
SEW_LOVELY_ORDER_EMAIL=orders@your-store.example
CUSTOMER_SESSION_SECRET=replace-with-a-random-32-byte-secret
# Server-only Stripe Checkout credentials. Never expose these as NEXT_PUBLIC_* variables.
STRIPE_SECRET_KEY=sk_live_replace_me
PAYMENT_WEBHOOK_SECRET=whsec_replace_me
# Optional: enable automatic SMTP delivery when a real mail service is configured.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-user
# SMTP_PASS=your-password
# SMTP_FROM=orders@your-store.example

# Resend transactional receipts
RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL=onboarding@resend.dev
ORDER_RECEIPT_EMAIL=orders@your-store.example
# Shared Sentry project DSN used by storefront and admin
NEXT_PUBLIC_SENTRY_STOREFRONT_DSN=https://public-key@o0.ingest.sentry.io/0

## Local-only manual Sentry verification; do not enable in production
SENTRY_TEST_MODE=false

# Cloudflare R2 S3-compatible object storage
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_ENDPOINT=https://replace-with-account-id.r2.cloudflarestorage.com
R2_BUCKET=sewlovely
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
