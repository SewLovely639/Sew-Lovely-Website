# Configure production values as Cloudflare Worker secrets; see ../../CLOUDFLARE_SECRETS.md.
# When Supabase is left empty, admin saves fall back to a local JSON file so the
# storefront studio still works in development.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
NEXT_PUBLIC_SENTRY_STOREFRONT_DSN=

# Optional: override the local fallback content file (defaults to
# packages/cms/data/content.json).
# SEW_LOVELY_CONTENT_FILE=
